# Local development values
# Full reference: docs/environment.md
#
# In most cases you do not create this file by hand.
# `pnpm run setup` writes the real values to `.env.local`.

# local: (classic) or anonymous: (CONVEX_AGENT_MODE=anonymous on Railway local/PR)
CONVEX_DEPLOYMENT=local:your-local-deployment
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Proxied Railway local/PR (.env.local stays loopback — Convex writes VITE_CONVEX_* as 127.0.0.1):
# VITE_CONVEX_BACKEND_URL=http://127.0.0.1:3212
# VITE_CONVEX_BACKEND_SITE_URL=http://127.0.0.1:3213
# Public browser URLs are NOT stored in .env.local; dev-all exports them for Vite:
#   VITE_CONVEX_URL=https://<pr-domain>/_convex
#   VITE_CONVEX_SITE_URL=https://<pr-domain>/_convex_site

# Optional explicit public app URL (overrides Railway auto-detection)
# PUBLIC_APP_URL=https://your-app.example.com

# Convex backend environment values (set via `pnpm run setup`, not committed)
# SITE_URL=http://localhost:5173
# CUSTOM_AUTH_SITE_URL=http://127.0.0.1:3211
# AUTH_GOOGLE_EMULATE_URL=http://localhost:4002
# RESEND_BASE_URL=http://localhost:4003
# RESEND_API_KEY=re_emulate_test_key
# PLATFORM_ADMIN_EMAILS=dev@example.com,admin@example.com,platform@example.com,testuser@gmail.com

# Google OAuth — real credentials stored in Convex (production / staging with Google)
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...

# Cypress E2E programmatic sign-in (export in shell or add to .env.local; pushed by `pnpm run e2e:setup`, not setup)
# E2E_AUTH_SECRET=local-e2e-secret

# Production / staging (Railway environment variables)
# CONVEX_DEPLOY_KEY=...
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
# VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
# PUBLIC_APP_URL=https://your-app.up.railway.app
