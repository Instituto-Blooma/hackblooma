{
  "name": "hackblooma",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "setup": "node script/setup.mjs",
    "dev:emulate": "node script/run.mjs emulate",
    "dev:backend": "npx convex dev --local-force-upgrade",
    "dev:backend:stable": "npx convex dev",
    "dev:backend:remote": "npx convex dev --typecheck=disable",
    "dev:all": "node script/run.mjs dev",
    "dev": "vite",
    "build:convex": "pnpm convex dev --once --tail-logs=disable",
    "prefetch:convex:local": "node script/prefetch-convex-local.mjs",
    "build": "pnpm run build:convex && vite build",
    "deploy:convex": "pnpm convex deploy",
    "preview": "vite preview",
    "start": "vite preview",
    "start:deploy": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "prepare": "husky",
    "lint": "oxlint --tsconfig tsconfig.json client convex cypress script tailwind.config.ts vite.config.ts vitest.config.ts cypress.config.ts postcss.config.js",
    "lint:fix": "pnpm run lint -- --fix",
    "format": "oxfmt -c .oxfmtrc.json --write .",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "typecheck": "tsgo -p tsconfig.json --noEmit",
    "typecheck:convex": "tsgo -p convex/tsconfig.json --noEmit",
    "typecheck:cypress": "tsgo -p cypress/tsconfig.json --noEmit",
    "typecheck:all": "pnpm run typecheck && pnpm run typecheck:convex && pnpm run typecheck:cypress",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck:all",
    "check:fix": "pnpm run format && pnpm run lint:fix && pnpm run check",
    "check:all": "pnpm run check:fix && (pnpm run e2e:run || echo '[check] e2e is non-mandatory; it did not pass.')",
    "test": "vitest run",
    "cy:open": "cypress open",
    "cy:run": "cypress run --",
    "seed:dev": "node script/seed.mjs dev",
    "e2e:stack": "node script/e2e.mjs monitor",
    "e2e:stack:up": "node script/e2e.mjs up",
    "e2e:stack:down": "node script/e2e.mjs down",
    "e2e:setup": "node script/e2e.mjs setup",
    "e2e:run": "node script/e2e.mjs run --",
    "e2e:open": "pnpm e2e:setup && cypress open"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "^0.0.90",
    "@djpanda/convex-authz": "^2.4.0",
    "@djpanda/convex-tenants": "^0.5.0",
    "@mdxeditor/editor": "4.0.4",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@talentum-ventures/convex-datatable": "^0.4.1",
    "@talentum-ventures/convex-presence": "^0.1.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-devtools": "^1.167.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "adm-zip": "^0.5.16",
    "convex": "^1.43.0",
    "date-fns": "^4.4.0",
    "imask": "7.6.1",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-colorful": "^5.7.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-imask": "^7.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.27",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript/native-preview": "7.0.0-dev.20260525.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "cypress": "^15.14.2",
    "emulate": "^0.5.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.43.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.6",
    "yaml": "^2.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "bufferutil",
      "esbuild",
      "protobufjs"
    ]
  }
}
